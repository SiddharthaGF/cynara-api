{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "src/Cynara.Api/Cynara.Api.csproj",
        "--configuration",
        "Debug",
        "--framework",
        "net9.0",
        "--no-launch-profile"
      ],
      "problemMatcher": ["$msbuild"],
      "isBackground": true,
      "serverReadyAction": {
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "forwardPorts"
      }
    }
  ]
}
