{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "cake",
        "--target=Format",
        "--include=${staged:;}"
      ],
      "include": ["**/*.cs"]
    },
    {
      "name": "lint",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "cake",
        "--target=Lint"
      ],
      "include": ["**/*.cs"]
    }
  ]
}
