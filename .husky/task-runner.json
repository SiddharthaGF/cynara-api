{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "Cynara.Api.sln", "--include", "${staged}"],
      "include": ["**/*.cs"]
    },
    {
      "name": "lint",
      "group": "pre-commit",
      "command": "bash",
      "args": [
        "-c",
        "git diff --cached --name-only --diff-filter=ACM | grep -q '\\.cs$' || exit 0; dotnet build Cynara.Api.sln --no-restore -warnaserror -c Debug"
      ]
    }
  ]
}
