{
  "simpleEqVisibleWhen": {
    "visibleWhen": {
      "op": "eq",
      "args": [{ "ref": "intake.smoking" }, { "lit": "yes" }]
    }
  },
  "compoundVisibleWhen": {
    "visibleWhen": {
      "op": "and",
      "args": [
        {
          "op": "eq",
          "args": [{ "ref": "intake.hasMedications" }, { "lit": true }]
        },
        {
          "op": "not",
          "args": [{ "op": "empty", "args": [{ "ref": "intake.consent" }] }]
        }
      ]
    }
  },
  "enabledUnless": {
    "enabledWhen": {
      "op": "neq",
      "args": [{ "ref": "assessment.consciousness" }, { "lit": "unresponsive" }]
    }
  },
  "requiredWhenBoolean": {
    "requiredWhen": { "ref": "patient.hasAllergies" }
  },
  "calculateCopy": {
    "note": "Target clinical field must be readOnly: true",
    "calculate": { "ref": "vital.heart-rate" }
  },
  "calculateArithmetic": {
    "note": "Target clinical field must be readOnly: true",
    "calculate": {
      "op": "mul",
      "args": [{ "ref": "order.qty" }, { "ref": "order.unitPrice" }]
    }
  },
  "crossFieldValidation": {
    "code": "BP_SYSTOLIC_GT_DIASTOLIC",
    "message": "Systolic blood pressure must be greater than diastolic",
    "when": {
      "op": "and",
      "args": [
        {
          "op": "not",
          "args": [{ "op": "empty", "args": [{ "ref": "vital.bp.systolic" }] }]
        },
        {
          "op": "not",
          "args": [{ "op": "empty", "args": [{ "ref": "vital.bp.diastolic" }] }]
        }
      ]
    },
    "assert": {
      "op": "gt",
      "args": [{ "ref": "vital.bp.systolic" }, { "ref": "vital.bp.diastolic" }]
    }
  }
}
