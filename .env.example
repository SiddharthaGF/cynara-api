# =============================================================================
# Cynara environment overrides
# =============================================================================
# Copy this file to `.env` (which is gitignored) and adjust the values for
# your local setup. Both `docker compose` and `dotnet run` read these via the
# shell — most CI pipelines load them through `direnv`, `dotenv`, or
# `docker compose --env-file`.
# =============================================================================

## PostgreSQL (used by docker-compose.yml and by the API connection string)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

## pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

## Cynara API — connection string
## Mirror docker-compose credentials so `dotnet run` connects to the same DB.
CONNECTIONSTRINGS_DEFAULT=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres

## Cynara API — CORS
## Comma-separated list of origins allowed to call the API from the browser.
## ASPNETCORE_CORS_ALLOWEDORIGINS__0=http://localhost:3000
## ASPNETCORE_CORS_ALLOWEDORIGINS__1=http://localhost:5173

## Cynara API — hospital bootstrap
## ASPNETCORE_HOSPITALS__BOOTSTRAPCODE=default
## ASPNETCORE_HOSPITALS__BOOTSTRAPNAME=Default workspace
## ASPNETCORE_HOSPITALS__HEADERNAME=X-Hospital-Code
## ASPNETCORE_HOSPITALS__ALLOWAUTOBOOTSTRAP=true

## Cynara API — environment
## ASPNETCORE_ENVIRONMENT=Development
## DOTNET_ENVIRONMENT=Development

## =============================================================================
## Form AI provider (OpenAI-compatible)
## =============================================================================
## The Form AI provider reads OPENAI_* from the environment. Leave OPENAI_API_KEY
## unset to disable Form AI; the API still boots and serves every other module.

## OPENAI_API_KEY=sk-replace-me
## OPENAI_BASE_URL=https://api.openai.com/v1
## OPENAI_MODEL=gpt-4o-mini
## OPENAI_JSON_OBJECT=true
## OPENAI_NETWORK_TIMEOUT_SECONDS=600
## OPENAI_FIRST_CHUNK_TIMEOUT_SECONDS=90
## OPENAI_MAX_OUTPUT_TOKENS=
## OPENAI_TEMPERATURE=0.2
## OPENAI_TOP_P=1.0
