{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://cynara-web.livesanty.workers.dev"
    ]
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=cynara.db"
  },
  "Hospitals": {
    "BootstrapCode": "default",
    "BootstrapName": "Default workspace",
    "HeaderName": "X-Hospital-Code",
    "AllowAutoBootstrap": true
  }
}
