{
  "_comment": "Copy to appsettings.Local.json and fill in. gitignore excludes *.local.json and appsettings.*.local.json, so this template is safe to commit while real secrets stay untracked.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "_comment_cors": "Add the local cynara-web origins you run. The committed appsettings.json only lists the production worker; add your dev origins here or via the CORS__AllowedOrigins__0 env var.",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://cynara-web.livesanty.workers.dev"
    ]
  },
  "Database": {
    "_comment_provider": "Sqlite (default, zero-setup) or SqlServer (requires a connection string and a reachable SQL Server).",
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "_comment_default": "Sqlite path is relative to src/Cynara.Api. For SqlServer pass a full connection string.",
    "Default": "Data Source=cynara.db"
  },
  "FormAi": {
    "_comment_env": "These keys map to OPENAI_* environment variables consumed by OpenAiConfiguration. Prefer environment variables over committing secrets here.",
    "OPENAI_API_KEY": "",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "gpt-4o-mini",
    "OPENAI_JSON_OBJECT": "true",
    "OPENAI_NETWORK_TIMEOUT_SECONDS": "600",
    "OPENAI_FIRST_CHUNK_TIMEOUT_SECONDS": "90",
    "OPENAI_MAX_OUTPUT_TOKENS": "",
    "OPENAI_TEMPERATURE": "",
    "OPENAI_TOP_P": ""
  }
}