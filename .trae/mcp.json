{
  "mcpServers": {
    "sonarqube": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/.trae/sonarqube-mcp.sh"
      ]
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5432/postgres"
      ]
    }
  }
}
